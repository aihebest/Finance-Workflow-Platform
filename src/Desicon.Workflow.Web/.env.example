# Entra ID app registration backing the SPA. This is the same application the
# API validates tokens against (entra_client_id in dev.auto.tfvars); the SPA
# needs its own redirect URI registered as a Single-page application platform,
# not Web -- the Web platform expects a client secret, which a browser cannot
# hold.
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=

# Scope the SPA requests for the API. api://<api-client-id>/access_as_user
VITE_API_SCOPE=

# Base URL of the API. Empty means same-origin, which is the deployed shape:
# SPA and API both behind Front Door.
VITE_API_BASE_URL=

# Development only: where `npm run dev` proxies /api to.
VITE_DEV_API_PROXY=http://localhost:5080
