<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Desicon.Workflow.Infrastructure</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.10" />
    <!--
      Azure.Core for TokenCredential only, so the Graph sender can take a
      credential without this project depending on Azure.Identity or on the
      Graph SDK. Which credential to use is the host's decision: managed
      identity in Azure, az login locally.
    -->
    <!--
      1.44.1, not 1.42.0. Azure.Storage.Blobs 12.22.2 requires >= 1.44.1
      transitively, and NuGet reports the direct reference as a downgrade
      (NU1605, an error here). Pinning the higher version is the fix; the
      alternative (letting the transitive win silently) is how a
      MissingMethodException arrives at runtime instead of at build.
    -->
    <PackageReference Include="Azure.Core" Version="1.55.0" />
    <!--
      Blob storage for receipt attachments. Same arrangement as Azure.Core
      above: the SDK lives here, the choice of credential stays with the host.
    -->
    <PackageReference Include="Azure.Storage.Blobs" Version="12.29.1" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Desicon.Workflow.Core\Desicon.Workflow.Core.csproj" />
    <ProjectReference Include="..\Desicon.Workflow.Domain\Desicon.Workflow.Domain.csproj" />
  </ItemGroup>
</Project>
