root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,jsonc,yml,yaml,tf,tfvars,md,ts,tsx,js,jsx,css}]
indent_size = 2

[*.cs]
dotnet_sort_system_directives_first = true
csharp_new_line_before_open_brace = all
csharp_style_namespace_declarations = file_scoped:warning
# for_non_interface_members, not always. Interface members are public by
# definition and writing "public" on them is noise -- but newer .NET SDKs
# extended IDE0040 to cover them under "always", so the same source built
# clean on one machine and produced sixteen errors on another. With
# TreatWarningsAsErrors that is a build break, not a style nit.
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
csharp_style_var_when_type_is_apparent = true:suggestion

# Never build raw SQL by hand -- parameterised EF Core only.
dotnet_diagnostic.CA2100.severity = error
# Do not swallow general exceptions.
dotnet_diagnostic.CA1031.severity = warning
# Specify culture explicitly on string operations.
dotnet_diagnostic.CA1305.severity = error

[*.{md}]
trim_trailing_whitespace = false
