!.env.example

# Security scan artefacts
reports/
*.sarif

# IDE
.vs/
.idea/
*.swp
.DS_Store

# Azure Functions local development settings. Holds connection strings and
# AzureWebJobsStorage for the local host; never committed.
local.settings.json

# TypeScript incremental build cache. Machine-local; committing it makes every
# checkout differ and tells tsc things about a build that did not happen here.
*.tsbuildinfo

# Downloaded App Service logs (az webapp log download). Bulky, and they carry
# every SQL statement the app executed plus stack traces -- diagnostic output
# belongs in Application Insights, not in version control.
applogs/
*.zip

# The real org chart: staff names, addresses and reporting lines. Loaded by
# scripts/import-org-chart.ps1 and deliberately not versioned -- it is
# personal data that goes stale, and this repository is shared.
org-chart.csv
*-org-chart.csv
