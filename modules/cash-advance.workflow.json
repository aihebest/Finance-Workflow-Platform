{
  "$schema": "./workflow-definition.schema.json",
  "moduleKey": "CASH_ADVANCE",
  "displayName": "Cash Advance - To Be Justified",
  "formCode": "DEL-AC-FRM-003",
  "formRevision": "05",
  "version": 2,
  "effectiveFrom": "2026-08-08T00:00:00Z",
  "numberFormat": "ADV-{yyyy}-{seq:000000}",
  "workingCalendar": "NG_STANDARD",
  "slaPausesOutsideWorkingHours": true,
  "policyValues": [
    {
      "key": "RETIREMENT_HOURS_IN_STATION",
      "value": 24,
      "note": "Source: DEL-AC-FRM-003 Rev 05 footer. Measured in WORKING hours from cash release, per Finance direction."
    },
    {
      "key": "RETIREMENT_HOURS_OUT_OF_STATION",
      "value": 72,
      "note": "Source: DEL-AC-FRM-003 Rev 05 footer. Measured in WORKING hours from cash release, per Finance direction."
    },
    {
      "key": "BLOCK_NEW_ADVANCE_WHEN_OVERDUE",
      "value": 1,
      "note": "The form makes an unretired advance the personal liability of the recipient. Blocking further advances is the mildest enforcement of that; confirm against existing practice."
    },
    {
      "key": "PAYMENT_METHOD_THRESHOLD_NGN",
      "value": 30000,
      "note": "Same rule and figure as EXPENSE's own PAYMENT_METHOD_THRESHOLD_NGN (DEL-AC-FRM-002 Rev 05 footer), applied to TotalAmountNgn via CashAdvanceRequest.ApplyPaymentMethodPolicy since an advance has no net-payable concept of its own. A future rate change is a new row here with a later effectiveFrom, not an edit to this one -- see WorkflowDefinitionExtensions.GetPolicyValue."
    }
  ],
  "states": [
    {
      "key": "DRAFT",
      "type": "initial",
      "label": "Draft"
    },
    {
      "key": "LINE_MANAGER",
      "label": "Awaiting Verification (Line Manager)",
      "sla": {
        "hours": 24,
        "reminderEveryHours": 8,
        "escalateTo": "DEPT_HEAD"
      }
    },
    {
      "key": "DEPT_HEAD",
      "label": "Awaiting Approval (Department Head)",
      "sla": {
        "hours": 24,
        "reminderEveryHours": 8,
        "escalateTo": "COST_CONTROL_VERIFY"
      }
    },
    {
      "key": "COST_CONTROL_VERIFY",
      "label": "Cost Control Verification",
      "sla": {
        "hours": 24,
        "reminderEveryHours": 8
      }
    },
    {
      "key": "FINANCE_APPROVE",
      "label": "Awaiting Approval (Accounts Manager)",
      "sla": {
        "hours": 24,
        "reminderEveryHours": 8
      }
    },
    {
      "key": "DMD_APPROVAL",
      "label": "Awaiting Payment Approval (Director of Finance)",
      "sla": {
        "hours": 24,
        "reminderEveryHours": 8
      }
    },
    {
      "key": "AWAITING_POSTING",
      "label": "Awaiting Posting in Business Central",
      "sla": {
        "hours": 24,
        "reminderEveryHours": 8
      }
    },
    {
      "key": "CASH_RELEASE",
      "label": "Awaiting Cash Release",
      "sla": {
        "hours": 24,
        "reminderEveryHours": 8
      }
    },
    {
      "key": "AWAITING_ACK",
      "label": "Awaiting Recipient Acknowledgement",
      "sla": {
        "hours": 24,
        "reminderEveryHours": 8
      }
    },
    {
      "key": "OUTSTANDING",
      "label": "Outstanding - Awaiting Retirement",
      "sla": {
        "hours": 24,
        "reminderEveryHours": 8
      }
    },
    {
      "key": "PARTIALLY_RETIRED",
      "label": "Partially Retired",
      "sla": {
        "hours": 24,
        "reminderEveryHours": 8
      }
    },
    {
      "key": "RETURNED",
      "type": "rework",
      "label": "Returned for Correction"
    },
    {
      "key": "REJECTED",
      "type": "terminal",
      "label": "Rejected"
    },
    {
      "key": "CLOSED",
      "type": "terminal",
      "label": "Closed - Fully Retired"
    }
  ],
  "transitions": [
    {
      "from": "DRAFT",
      "to": "LINE_MANAGER",
      "action": "SUBMIT",
      "actor": {
        "resolver": "Requester"
      },
      "guard": "LineCount > 0 && TotalAmountNgn > 0 && HasValidAllocation == true && HasOverdueAdvance == false",
      "guardMessage": "Add at least one line, select a project or cost centre code, and retire any overdue advance before requesting another."
    },
    {
      "from": "LINE_MANAGER",
      "to": "DEPT_HEAD",
      "action": "VERIFY",
      "actor": {
        "resolver": "LineManagerOf",
        "arg": "RequesterId"
      },
      "guard": "ActorId != RequesterId",
      "guardMessage": "You cannot verify your own request."
    },
    {
      "from": "LINE_MANAGER",
      "to": "RETURNED",
      "action": "RETURN",
      "actor": {
        "resolver": "LineManagerOf",
        "arg": "RequesterId"
      },
      "requiresComment": true
    },
    {
      "from": "LINE_MANAGER",
      "to": "REJECTED",
      "action": "REJECT",
      "actor": {
        "resolver": "LineManagerOf",
        "arg": "RequesterId"
      },
      "requiresComment": true
    },
    {
      "from": "DEPT_HEAD",
      "to": "COST_CONTROL_VERIFY",
      "action": "VERIFY",
      "actor": {
        "resolver": "DepartmentHeadOf",
        "arg": "DepartmentId"
      },
      "guard": "ActorId != RequesterId",
      "guardMessage": "You cannot verify your own request."
    },
    {
      "from": "DEPT_HEAD",
      "to": "RETURNED",
      "action": "RETURN",
      "actor": {
        "resolver": "DepartmentHeadOf",
        "arg": "DepartmentId"
      },
      "requiresComment": true
    },
    {
      "from": "DEPT_HEAD",
      "to": "REJECTED",
      "action": "REJECT",
      "actor": {
        "resolver": "DepartmentHeadOf",
        "arg": "DepartmentId"
      },
      "requiresComment": true
    },
    {
      "from": "COST_CONTROL_VERIFY",
      "to": "FINANCE_APPROVE",
      "action": "VERIFY",
      "actor": {
        "role": "FinanceOfficer"
      },
      "guard": "TreasuryNumber != null",
      "guardMessage": "Capture the Treasury number before passing this to the Finance Manager.",
      "captures": [
        "TreasuryNumber"
      ],
      "note": "Cost Control's check: the request is costed to the right centre and taken into BC. Same Accounts people who post later at AWAITING_POSTING, so the same role -- the state is named for the work, not a separate team."
    },
    {
      "from": "COST_CONTROL_VERIFY",
      "to": "RETURNED",
      "action": "RETURN",
      "actor": {
        "role": "FinanceOfficer"
      },
      "requiresComment": true
    },
    {
      "from": "COST_CONTROL_VERIFY",
      "to": "REJECTED",
      "action": "REJECT",
      "actor": {
        "role": "FinanceOfficer"
      },
      "requiresComment": true
    },
    {
      "from": "FINANCE_APPROVE",
      "to": "DMD_APPROVAL",
      "action": "APPROVE",
      "actor": {
        "role": "FinanceManager"
      },
      "guard": "ActorId != RequesterId",
      "guardMessage": "You cannot approve your own advance request.",
      "note": "The Accounts Manager releases the advance for treatment. She does not release the money -- that is the Director of Finance's alone."
    },
    {
      "from": "DMD_APPROVAL",
      "to": "AWAITING_POSTING",
      "action": "APPROVE",
      "actor": {
        "role": "DirectorOfFinance"
      },
      "guard": "ActorId != RequesterId",
      "guardMessage": "You cannot approve payment of your own advance.",
      "records": "AuthorisedByUserId",
      "note": "The gate. No cash leaves Desicon without the Director of Finance, and version 1 of this definition had no such step -- the Accounts Officer could release cash on the Accounts Manager's approval alone. Unconditional here, unlike expense: an advance always pays somebody."
    },
    {
      "from": "DMD_APPROVAL",
      "to": "RETURNED",
      "action": "RETURN",
      "actor": {
        "role": "DirectorOfFinance"
      },
      "requiresComment": true
    },
    {
      "from": "DMD_APPROVAL",
      "to": "REJECTED",
      "action": "REJECT",
      "actor": {
        "role": "DirectorOfFinance"
      },
      "requiresComment": true
    },
    {
      "from": "AWAITING_POSTING",
      "to": "CASH_RELEASE",
      "action": "MARK_POSTED",
      "actor": {
        "role": "FinanceOfficer"
      },
      "guard": "BcDocumentNumber != null",
      "guardMessage": "Enter the Business Central document number for this posting.",
      "captures": [
        "BcDocumentNumber"
      ],
      "records": "PostedByUserId",
      "note": "The Accounts Officer posts in Business Central, then records here that she has and under which document number. No journal lines are captured: BC owns the ledger, and a second copy in another system is two versions of the truth waiting to disagree. The document number is the only key joining this approval trail to the ledger entry, which is why it is required."
    },
    {
      "from": "AWAITING_POSTING",
      "to": "RETURNED",
      "action": "RETURN",
      "actor": {
        "role": "FinanceOfficer"
      },
      "requiresComment": true
    },
    {
      "from": "FINANCE_APPROVE",
      "to": "RETURNED",
      "action": "RETURN",
      "actor": {
        "role": "FinanceManager"
      },
      "requiresComment": true
    },
    {
      "from": "FINANCE_APPROVE",
      "to": "REJECTED",
      "action": "REJECT",
      "actor": {
        "role": "FinanceManager"
      },
      "requiresComment": true
    },
    {
      "from": "CASH_RELEASE",
      "to": "AWAITING_ACK",
      "action": "RELEASE_CASH",
      "actor": {
        "role": "FinanceOfficer"
      },
      "captures": [
        "CashReleasedAt"
      ],
      "effect": "StartRetirementClock",
      "note": "Cash release starts the retirement clock. Working hours against the NG_STANDARD calendar. PaymentMethod is derived by CashAdvanceRequest.ApplyPaymentMethodPolicy at submission/recalculation time, not captured here -- Finance cannot choose it at release."
    },
    {
      "from": "CASH_RELEASE",
      "to": "RETURNED",
      "action": "RETURN",
      "actor": {
        "role": "FinanceOfficer"
      },
      "requiresComment": true
    },
    {
      "from": "AWAITING_ACK",
      "to": "OUTSTANDING",
      "action": "ACKNOWLEDGE",
      "actor": {
        "resolver": "Requester"
      },
      "records": "AcknowledgedByUserId",
      "effect": "RecordAcknowledgement",
      "note": "Recipient's Acknowledgement. Recorded for the audit trail and the printed form; the clock already started at release."
    },
    {
      "from": "AWAITING_ACK",
      "to": "RETURNED",
      "action": "RETURN",
      "actor": {
        "role": "FinanceOfficer"
      },
      "requiresComment": true
    },
    {
      "from": "OUTSTANDING",
      "to": "PARTIALLY_RETIRED",
      "action": "RETIRE",
      "actor": {
        "resolver": "Requester"
      },
      "guard": "RetirementBalanceNgn > 0",
      "guardMessage": "This advance already carries no balance."
    },
    {
      "from": "OUTSTANDING",
      "to": "CLOSED",
      "action": "RETIRE",
      "actor": {
        "resolver": "Requester"
      },
      "guard": "RetirementBalanceNgn <= 0",
      "guardMessage": "A balance remains outstanding on this advance."
    },
    {
      "from": "OUTSTANDING",
      "to": "REJECTED",
      "action": "WRITE_OFF",
      "actor": {
        "role": "FinanceManager"
      },
      "requiresComment": true,
      "note": "Terminal disposal for an advance that will not be retired. Requires a reason and is reported to management."
    },
    {
      "from": "PARTIALLY_RETIRED",
      "to": "CLOSED",
      "action": "RETIRE",
      "actor": {
        "resolver": "Requester"
      },
      "guard": "RetirementBalanceNgn <= 0",
      "guardMessage": "A balance remains outstanding on this advance."
    },
    {
      "from": "PARTIALLY_RETIRED",
      "to": "PARTIALLY_RETIRED",
      "action": "RETIRE",
      "actor": {
        "resolver": "Requester"
      },
      "guard": "RetirementBalanceNgn > 0",
      "guardMessage": "This advance already carries no balance."
    },
    {
      "from": "PARTIALLY_RETIRED",
      "to": "REJECTED",
      "action": "WRITE_OFF",
      "actor": {
        "role": "FinanceManager"
      },
      "requiresComment": true
    },
    {
      "from": "RETURNED",
      "to": "LINE_MANAGER",
      "action": "RESUBMIT",
      "actor": {
        "resolver": "Requester"
      },
      "effect": "IncrementRevisionNumber"
    }
  ],
  "notifications": [
    {
      "on": "STATE_ENTERED",
      "to": "CurrentActor",
      "template": "action-required"
    },
    {
      "on": "COST_CONTROL_VERIFY",
      "to": "FinanceOfficer",
      "template": "action-required"
    },
    {
      "on": "FINANCE_APPROVE",
      "to": "FinanceManager",
      "template": "action-required"
    },
    {
      "on": "DMD_APPROVAL",
      "to": "DirectorOfFinance",
      "template": "payment-approval-required"
    },
    {
      "on": "AWAITING_POSTING",
      "to": "FinanceOfficer",
      "template": "posting-required"
    },
    {
      "on": "CASH_RELEASE",
      "to": "FinanceOfficer",
      "template": "action-required"
    },
    {
      "on": "SLA_REMINDER",
      "to": "CurrentActor",
      "template": "reminder"
    },
    {
      "on": "SLA_BREACHED",
      "to": [
        "CurrentActor",
        "EscalationTarget"
      ],
      "template": "escalation"
    },
    {
      "on": "RETURNED",
      "to": "Requester",
      "template": "returned-for-correction"
    },
    {
      "on": "REJECTED",
      "to": "Requester",
      "template": "rejected"
    },
    {
      "on": "AWAITING_ACK",
      "to": "Requester",
      "template": "confirm-cash-receipt"
    },
    {
      "on": "RETIREMENT_DUE",
      "to": "Requester",
      "template": "retirement-due"
    },
    {
      "on": "RETIREMENT_OVERDUE",
      "to": [
        "Requester",
        "LineManager",
        "FinanceManager"
      ],
      "template": "retirement-overdue"
    },
    {
      "on": "CLOSED",
      "to": "Requester",
      "template": "closed"
    },
    {
      "on": "RETIREMENT_DUE_SOON",
      "to": "Requester",
      "template": "retirement-due-soon"
    }
  ],
  "retirementClock": {
    "unit": "WorkingHours",
    "startsAt": "CASH_RELEASE",
    "calendar": "NG_STANDARD",
    "note": "Per Finance direction 31 Jul 2026. On a 9-hour working day this makes 24h = 2.67 working days and 72h = 8 working days. Change 'unit' to CalendarHours if that proves not to be the intent."
  },
  "note": "Version 2 mirrors the expense module: GL posting moves to Microsoft Dynamics Business Central, so POSTING/AUTHORISATION collapse into a single AWAITING_POSTING step, and DMD_APPROVAL is added because no cash leaves Desicon without the Director of Finance. Unlike expense, the gate here is unconditional -- an advance always pays somebody. Retirement, which follows via a linked expense claim, never reaches him. See docs/14-Process-As-Described.md."
}
