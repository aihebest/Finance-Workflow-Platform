{
  "$schema": "./workflow-definition.schema.json",
  "moduleKey": "CASH_ADVANCE",
  "displayName": "Cash Advance - To Be Justified",
  "formCode": "DEL-AC-FRM-003",
  "formRevision": "05",
  "version": 1,
  "effectiveFrom": "2026-09-01T00:00:00Z",
  "numberFormat": "ADV-{yyyy}-{seq:000000}",
  "workingCalendar": "NG_STANDARD",
  "slaPausesOutsideWorkingHours": true,
  "policyValues": [
    {
      "key": "RETIREMENT_HOURS_IN_STATION",
      "value": 24,
      "note": "Source: DEL-AC-FRM-003 Rev 05 footer. Measured in WORKING hours from cash release, per Finance direction."
    },
    {
      "key": "RETIREMENT_HOURS_OUT_OF_STATION",
      "value": 72,
      "note": "Source: DEL-AC-FRM-003 Rev 05 footer. Measured in WORKING hours from cash release, per Finance direction."
    },
    {
      "key": "BLOCK_NEW_ADVANCE_WHEN_OVERDUE",
      "value": 1,
      "note": "The form makes an unretired advance the personal liability of the recipient. Blocking further advances is the mildest enforcement of that; confirm against existing practice."
    }
  ],
  "states": [
    {
      "key": "DRAFT",
      "type": "initial",
      "label": "Draft"
    },
    {
      "key": "LINE_MANAGER",
      "label": "Awaiting Verification (Line Manager)",
      "sla": {
        "hours": 24,
        "reminderEveryHours": 8,
        "escalateTo": "DEPT_HEAD"
      }
    },
    {
      "key": "DEPT_HEAD",
      "label": "Awaiting Verification (Department Head)",
      "sla": {
        "hours": 24,
        "reminderEveryHours": 8,
        "escalateTo": "FINANCE_VERIFY"
      }
    },
    {
      "key": "FINANCE_VERIFY",
      "label": "Finance Verification",
      "sla": {
        "hours": 24,
        "reminderEveryHours": 8
      }
    },
    {
      "key": "FINANCE_APPROVE",
      "label": "Awaiting Approval (Finance Manager)",
      "sla": {
        "hours": 24,
        "reminderEveryHours": 8
      }
    },
    {
      "key": "POSTING",
      "label": "GL Posting (Inputer)",
      "sla": {
        "hours": 12,
        "reminderEveryHours": 4
      }
    },
    {
      "key": "AUTHORISATION",
      "label": "Posting Authorisation (Checker)",
      "sla": {
        "hours": 12,
        "reminderEveryHours": 4
      }
    },
    {
      "key": "CASH_RELEASE",
      "label": "Awaiting Cash Release",
      "sla": {
        "hours": 24,
        "reminderEveryHours": 8
      }
    },
    {
      "key": "AWAITING_ACK",
      "label": "Awaiting Recipient Acknowledgement",
      "sla": {
        "hours": 24,
        "reminderEveryHours": 8
      }
    },
    {
      "key": "OUTSTANDING",
      "label": "Outstanding - Awaiting Retirement",
      "sla": {
        "hours": 24,
        "reminderEveryHours": 8
      }
    },
    {
      "key": "PARTIALLY_RETIRED",
      "label": "Partially Retired",
      "sla": {
        "hours": 24,
        "reminderEveryHours": 8
      }
    },
    {
      "key": "RETURNED",
      "type": "rework",
      "label": "Returned for Correction"
    },
    {
      "key": "REJECTED",
      "type": "terminal",
      "label": "Rejected"
    },
    {
      "key": "CLOSED",
      "type": "terminal",
      "label": "Closed - Fully Retired"
    }
  ],
  "transitions": [
    {
      "from": "DRAFT",
      "to": "LINE_MANAGER",
      "action": "SUBMIT",
      "actor": {
        "resolver": "Requester"
      },
      "guard": "LineCount > 0 && TotalAmountNgn > 0 && HasValidAllocation == true && HasOverdueAdvance == false",
      "guardMessage": "Add at least one line, select a project or cost centre code, and retire any overdue advance before requesting another."
    },
    {
      "from": "LINE_MANAGER",
      "to": "DEPT_HEAD",
      "action": "VERIFY",
      "actor": {
        "resolver": "LineManagerOf",
        "arg": "RequesterId"
      },
      "guard": "ActorId != RequesterId",
      "guardMessage": "You cannot verify your own request."
    },
    {
      "from": "LINE_MANAGER",
      "to": "RETURNED",
      "action": "RETURN",
      "actor": {
        "resolver": "LineManagerOf",
        "arg": "RequesterId"
      },
      "requiresComment": true
    },
    {
      "from": "LINE_MANAGER",
      "to": "REJECTED",
      "action": "REJECT",
      "actor": {
        "resolver": "LineManagerOf",
        "arg": "RequesterId"
      },
      "requiresComment": true
    },
    {
      "from": "DEPT_HEAD",
      "to": "FINANCE_VERIFY",
      "action": "VERIFY",
      "actor": {
        "resolver": "DepartmentHeadOf",
        "arg": "DepartmentId"
      },
      "guard": "ActorId != RequesterId",
      "guardMessage": "You cannot verify your own request."
    },
    {
      "from": "DEPT_HEAD",
      "to": "RETURNED",
      "action": "RETURN",
      "actor": {
        "resolver": "DepartmentHeadOf",
        "arg": "DepartmentId"
      },
      "requiresComment": true
    },
    {
      "from": "DEPT_HEAD",
      "to": "REJECTED",
      "action": "REJECT",
      "actor": {
        "resolver": "DepartmentHeadOf",
        "arg": "DepartmentId"
      },
      "requiresComment": true
    },
    {
      "from": "FINANCE_VERIFY",
      "to": "FINANCE_APPROVE",
      "action": "VERIFY",
      "actor": {
        "role": "FinanceOfficer"
      },
      "guard": "TreasuryNumber != null",
      "guardMessage": "Capture the Treasury number before passing this to the Finance Manager.",
      "captures": [
        "TreasuryNumber"
      ]
    },
    {
      "from": "FINANCE_VERIFY",
      "to": "RETURNED",
      "action": "RETURN",
      "actor": {
        "role": "FinanceOfficer"
      },
      "requiresComment": true
    },
    {
      "from": "FINANCE_VERIFY",
      "to": "REJECTED",
      "action": "REJECT",
      "actor": {
        "role": "FinanceOfficer"
      },
      "requiresComment": true
    },
    {
      "from": "FINANCE_APPROVE",
      "to": "POSTING",
      "action": "APPROVE",
      "actor": {
        "role": "FinanceManager"
      },
      "guard": "ActorId != RequesterId",
      "guardMessage": "You cannot approve your own advance request."
    },
    {
      "from": "FINANCE_APPROVE",
      "to": "RETURNED",
      "action": "RETURN",
      "actor": {
        "role": "FinanceManager"
      },
      "requiresComment": true
    },
    {
      "from": "FINANCE_APPROVE",
      "to": "REJECTED",
      "action": "REJECT",
      "actor": {
        "role": "FinanceManager"
      },
      "requiresComment": true
    },
    {
      "from": "POSTING",
      "to": "AUTHORISATION",
      "action": "POST",
      "actor": {
        "role": "FinanceOfficer"
      },
      "guard": "GlDebitTotal == GlCreditTotal && GlLineCount >= 2 && JournalVoucherNumber != null",
      "guardMessage": "Debits must equal credits and a JV number is required.",
      "captures": [
        "JournalVoucherNumber",
        "GlPostingLines"
      ],
      "records": "PostedByUserId",
      "note": "Mirrors the DEBIT / CREDIT BENEFICIARY block in FOR ACF DEPT USE ONLY."
    },
    {
      "from": "POSTING",
      "to": "RETURNED",
      "action": "RETURN",
      "actor": {
        "role": "FinanceOfficer"
      },
      "requiresComment": true
    },
    {
      "from": "AUTHORISATION",
      "to": "CASH_RELEASE",
      "action": "AUTHORISE",
      "actor": {
        "role": "FinanceManager"
      },
      "guard": "ActorId != PostedByUserId",
      "guardMessage": "The authoriser must be a different person from the inputer.",
      "records": "AuthorisedByUserId",
      "note": "Maker-checker, mirroring the separate Inputers sign and Authorisers sign."
    },
    {
      "from": "AUTHORISATION",
      "to": "RETURNED",
      "action": "RETURN",
      "actor": {
        "role": "FinanceManager"
      },
      "requiresComment": true
    },
    {
      "from": "CASH_RELEASE",
      "to": "AWAITING_ACK",
      "action": "RELEASE_CASH",
      "actor": {
        "role": "FinanceOfficer"
      },
      "captures": [
        "CashReleasedAt",
        "PaymentMethod"
      ],
      "effect": "StartRetirementClock",
      "note": "Cash release starts the retirement clock. Working hours against the NG_STANDARD calendar."
    },
    {
      "from": "CASH_RELEASE",
      "to": "RETURNED",
      "action": "RETURN",
      "actor": {
        "role": "FinanceOfficer"
      },
      "requiresComment": true
    },
    {
      "from": "AWAITING_ACK",
      "to": "OUTSTANDING",
      "action": "ACKNOWLEDGE",
      "actor": {
        "resolver": "Requester"
      },
      "note": "Recipient's Acknowledgement. Recorded for the audit trail and the printed form; the clock already started at release."
    },
    {
      "from": "AWAITING_ACK",
      "to": "RETURNED",
      "action": "RETURN",
      "actor": {
        "role": "FinanceOfficer"
      },
      "requiresComment": true
    },
    {
      "from": "OUTSTANDING",
      "to": "PARTIALLY_RETIRED",
      "action": "RETIRE",
      "actor": {
        "resolver": "Requester"
      },
      "guard": "RetirementBalanceNgn > 0",
      "guardMessage": "This advance already carries no balance."
    },
    {
      "from": "OUTSTANDING",
      "to": "CLOSED",
      "action": "RETIRE",
      "actor": {
        "resolver": "Requester"
      },
      "guard": "RetirementBalanceNgn <= 0",
      "guardMessage": "A balance remains outstanding on this advance."
    },
    {
      "from": "OUTSTANDING",
      "to": "REJECTED",
      "action": "WRITE_OFF",
      "actor": {
        "role": "FinanceManager"
      },
      "requiresComment": true,
      "note": "Terminal disposal for an advance that will not be retired. Requires a reason and is reported to management."
    },
    {
      "from": "PARTIALLY_RETIRED",
      "to": "CLOSED",
      "action": "RETIRE",
      "actor": {
        "resolver": "Requester"
      },
      "guard": "RetirementBalanceNgn <= 0",
      "guardMessage": "A balance remains outstanding on this advance."
    },
    {
      "from": "PARTIALLY_RETIRED",
      "to": "PARTIALLY_RETIRED",
      "action": "RETIRE",
      "actor": {
        "resolver": "Requester"
      },
      "guard": "RetirementBalanceNgn > 0",
      "guardMessage": "This advance already carries no balance."
    },
    {
      "from": "PARTIALLY_RETIRED",
      "to": "REJECTED",
      "action": "WRITE_OFF",
      "actor": {
        "role": "FinanceManager"
      },
      "requiresComment": true
    },
    {
      "from": "RETURNED",
      "to": "LINE_MANAGER",
      "action": "RESUBMIT",
      "actor": {
        "resolver": "Requester"
      },
      "effect": "IncrementRevisionNumber"
    }
  ],
  "notifications": [
    {
      "on": "STATE_ENTERED",
      "to": "CurrentActor",
      "template": "action-required"
    },
    {
      "on": "SLA_REMINDER",
      "to": "CurrentActor",
      "template": "reminder"
    },
    {
      "on": "SLA_BREACHED",
      "to": [
        "CurrentActor",
        "EscalationTarget"
      ],
      "template": "escalation"
    },
    {
      "on": "RETURNED",
      "to": "Requester",
      "template": "returned-for-correction"
    },
    {
      "on": "REJECTED",
      "to": "Requester",
      "template": "rejected"
    },
    {
      "on": "AWAITING_ACK",
      "to": "Requester",
      "template": "confirm-cash-receipt"
    },
    {
      "on": "RETIREMENT_DUE",
      "to": "Requester",
      "template": "retirement-due"
    },
    {
      "on": "RETIREMENT_OVERDUE",
      "to": [
        "Requester",
        "LineManager",
        "FinanceManager"
      ],
      "template": "retirement-overdue"
    },
    {
      "on": "CLOSED",
      "to": "Requester",
      "template": "closed"
    },
    {
      "on": "RETIREMENT_DUE_SOON",
      "to": "Requester",
      "template": "retirement-due-soon"
    }
  ],
  "retirementClock": {
    "unit": "WorkingHours",
    "startsAt": "CASH_RELEASE",
    "calendar": "NG_STANDARD",
    "note": "Per Finance direction 31 Jul 2026. On a 9-hour working day this makes 24h = 2.67 working days and 72h = 8 working days. Change 'unit' to CalendarHours if that proves not to be the intent."
  }
}
